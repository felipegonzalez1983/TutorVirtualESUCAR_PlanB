<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========================================== -->
    <!-- INTERNET -->
    <!-- ========================================== -->

    <!-- Conexion para actualizar contenido -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <!-- ========================================== -->
    <!-- NOTIFICACIONES Y RECORDATORIOS -->
    <!-- ========================================== -->

    <!-- Notificaciones en Android 13 o superior -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Recuperar recordatorios al reiniciar -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ========================================== -->
    <!-- AUTENTICACION BIOMETRICA -->
    <!-- ========================================== -->

    <!-- Autenticacion con biometria compatible -->
    <uses-permission
        android:name="android.permission.USE_BIOMETRIC" />

    <!-- Compatibilidad con lectores de huella -->
    <!-- en versiones anteriores de Android -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT" />

    <!-- ========================================== -->
    <!-- UBICACION GPS -->
    <!-- ========================================== -->

    <!-- Ubicacion precisa y aproximada para registrar -->
    <!-- el lugar del trabajo de campo -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- El GPS es opcional: la aplicacion funciona sin el -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- ========================================== -->
    <!-- APLICACION ESUCAR -->
    <!-- ========================================== -->

    <application
        android:allowBackup="true"
        android:label="Tutor Virtual ESUCAR"
        android:supportsRtl="true"
        android:theme="@style/Theme.TutorVirtualESUCAR">

        <!-- ====================================== -->
        <!-- ACTIVIDAD PRINCIPAL -->
        <!-- ====================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- ====================================== -->
        <!-- RECORDATORIOS ACADEMICOS -->
        <!-- ====================================== -->

        <receiver
            android:name=".notifications.RecordatorioReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- ====================================== -->
        <!-- RECUPERAR ALARMAS TRAS REINICIO -->
        <!-- ====================================== -->

        <receiver
            android:name=".notifications.ReinicioReceiver"
            android:enabled="true"
            android:exported="false">

            <intent-filter>
                <action
                    android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>

        </receiver>

    </application>

</manifest>
